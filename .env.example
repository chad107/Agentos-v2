# AgentOS environment configuration (example only — never commit real secrets)
#
# v1 runs entirely on mock adapters and seeded demo data. None of the
# variables below are required to run the demo. They exist as configuration
# surfaces for the Phase 6 "real adapters" work described in
# 09_IMPLEMENTATION_PLAN.md, and are read (when present) through
# src/lib/env.ts, never imported directly into client components.

# --- App ---
NEXT_PUBLIC_APP_NAME="AgentOS"
NEXT_PUBLIC_BUSINESS_NAME="Valley River Heat Pumps"
AGENTOS_DEMO_MODE=true

# --- Local persistence (src/data/persistence.ts) ---
# Optional. Where the store's SQLite snapshot is written so data survives a
# process restart on a single, self-hosted instance. Defaults to
# .data/agentos.sqlite (gitignored) if unset. Not a substitute for a real
# production database — see README.md "Human-developer punch list", item 1.
AGENTOS_DB_PATH=

# --- Model provider abstraction (see src/cohen/model-provider.ts) ---
# Do not hard-code a single vendor in domain logic. Leave unset in the demo;
# Ask Cohen falls back to deterministic canned responses (src/cohen/ask-cohen.ts).
MODEL_PROVIDER=none
MODEL_PROVIDER_API_KEY=

# --- Jobber (Tier 1 — first operational source of truth) ---
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=
JOBBER_ACCESS_TOKEN=

# --- QuickBooks Online (Tier 1, read-oriented at launch) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ACCESS_TOKEN=

# --- Google Calendar (Tier 1) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# --- RingCentral (Tier 1) ---
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_ACCOUNT_ID=

# --- Voice provider (see 12_OPEN_ITEMS.md — not finalized) ---
VOICE_PROVIDER=none
VOICE_PROVIDER_API_KEY=

# --- CompanyCam (operational evidence, supporting source) ---
COMPANYCAM_API_KEY=

# --- Email (vendor invoices + customer threads; drafts-only at launch) ---
EMAIL_IMAP_HOST=
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=

# --- Tier 2 sources ---
FACEBOOK_LEADS_ACCESS_TOKEN=
GOOGLE_REVIEWS_API_KEY=
WEBSITE_FORMS_WEBHOOK_SECRET=

# --- Notifications ---
PUSH_NOTIFICATION_PROVIDER=none
PUSH_NOTIFICATION_KEY=
